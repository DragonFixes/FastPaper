+            int size = hopperStackList.size();
+            for (int i = 0; i < size; ++i) {
+                if (isSlotDisallowed(disallowedSlots, i)) continue; // Paper - Add PrepareHopperTransferEvent
+                ItemStack transferStack = hopperStackList.get(i);
