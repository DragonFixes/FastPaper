From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: swiftality <155652101+Swift-ality@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:14:12 +0100
Subject: [PATCH] Swift: inside-block effects skip empty flushes


diff --git a/net/minecraft/world/entity/InsideBlockEffectApplier.java b/net/minecraft/world/entity/InsideBlockEffectApplier.java
index c2f124383be06ae777c1ee7f0820c959c8359f87..b05ba376fcc0a5f64bf77a6b6229ee1ffb3ebf3a 100644
--- a/net/minecraft/world/entity/InsideBlockEffectApplier.java
+++ b/net/minecraft/world/entity/InsideBlockEffectApplier.java
@@ -41,6 +41,7 @@ public interface InsideBlockEffectApplier {
         );
         private final List<Consumer<Entity>> finalEffects = new ArrayList<>();
         private int lastStep = -1;
+        private int swift$pending; // Swift - effects collected since the last flush
 
         public void advanceStep(final int step, net.minecraft.core.BlockPos pos) { // Paper - track position inside effect was triggered on
             this.currentBlockPos = pos; // Paper - track position inside effect was triggered on
@@ -66,6 +67,15 @@ public interface InsideBlockEffectApplier {
         }
 
         private void flushStep() {
+            // Swift start - nothing collected since the last flush: the loop below would move nothing
+            if (this.swift$pending == 0 && io.papermc.paper.swift.entity.SwiftInsideBlocks.skipEmptyFlush) {
+                if (io.papermc.paper.swift.SwiftVerify.ENABLED) {
+                    this.swift$verifyEmpty();
+                }
+                return;
+            }
+            this.swift$pending = 0;
+            // Swift end - nothing collected since the last flush: the loop below would move nothing
             for (InsideBlockEffectType type : APPLY_ORDER) {
                 List<Consumer<Entity>> beforeEffects = this.beforeEffectsInStep.get(type);
                 this.finalEffects.addAll(beforeEffects);
@@ -82,19 +92,35 @@ public interface InsideBlockEffectApplier {
 
         @Override
         public void apply(final InsideBlockEffectType type) {
+            this.swift$pending++; // Swift
             this.effectsInStep.put(type, recorded(type)); // Paper - track position inside effect was triggered on
         }
 
         @Override
         public void runBefore(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.swift$pending++; // Swift
             this.beforeEffectsInStep.get(type).add(effect);
         }
 
         @Override
         public void runAfter(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.swift$pending++; // Swift
             this.afterEffectsInStep.get(type).add(effect);
         }
 
+        // Swift start - shadow verify: a skipped flush must have had nothing to move
+        private void swift$verifyEmpty() {
+            io.papermc.paper.swift.SwiftVerify.checked();
+            boolean empty = this.effectsInStep.isEmpty();
+            for (InsideBlockEffectType type : APPLY_ORDER) {
+                empty &= this.beforeEffectsInStep.get(type).isEmpty() && this.afterEffectsInStep.get(type).isEmpty();
+            }
+            if (!empty) {
+                io.papermc.paper.swift.SwiftVerify.mismatch("insideEffectSkipEmpty", "flush skipped with effects pending");
+            }
+        }
+        // Swift end - shadow verify: a skipped flush must have had nothing to move
+
         // Paper start - track position inside effect was triggered on
         private net.minecraft.core.@org.jspecify.annotations.Nullable BlockPos currentBlockPos = null;
 
