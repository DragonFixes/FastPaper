+                if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                    behavior.doStop(level, body, timestamp);
+                }
+            }
+        } else
+        // FastPaper end - gate index loop
         // Paper start - Perf: Remove streams from hot code
         for (final BehaviorControl<? super E> behavior : this.behaviors) {
             if (behavior.getStatus() == Behavior.Status.RUNNING) {
@@ -105,6 +132,19 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
         // Paper end - Perf: Remove streams from hot code
     }
 
+    // FastPaper start - gate index loop
+    public static boolean SWIFT_GATE_INDEX_LOOP = Boolean.parseBoolean(System.getProperty("swift.gateIndexLoop", "true")); // not final: tests compare both paths
+
+    private static boolean swift$anyRunning(final List<? extends ShufflingList.WeightedEntry<? extends BehaviorControl<?>>> entries) {
+        for (int i = 0; i < entries.size(); i++) {
+            if (entries.get(i).getData().getStatus() == Behavior.Status.RUNNING) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // FastPaper end - gate index loop
+
