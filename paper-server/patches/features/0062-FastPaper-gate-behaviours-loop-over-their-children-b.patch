Subject: [PATCH] FastPaper: gate behaviours loop over their children by index


diff --git a/net/minecraft/world/entity/ai/behavior/GateBehavior.java b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
index 3adfb334068d3722329f91011c41d5e59b1956c9..7afda1b1608e39eab8944c940bda870ee72bfbc5 100644
--- a/net/minecraft/world/entity/ai/behavior/GateBehavior.java
+++ b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
@@ -78,6 +78,22 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
 
     @Override
     public final void tickOrStop(final ServerLevel level, final E body, final long timestamp) {
+        // FastPaper start - gate index loop: the same children in the same order, read straight from the entry list
+        // instead of through a transforming iterator and a stream; "none running" is still checked after all ticked
+        if (SWIFT_GATE_INDEX_LOOP) {
+            final List<ShufflingList.WeightedEntry<BehaviorControl<? super E>>> entries = this.behaviors.entries;
+            for (int i = 0; i < entries.size(); i++) {
+                final BehaviorControl<? super E> behavior = entries.get(i).getData();
+                if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                    behavior.tickOrStop(level, body, timestamp);
+                }
+            }
+            if (!swift$anyRunning(entries)) {
+                this.doStop(level, body, timestamp);
+            }
+            return;
+        }
+        // FastPaper end - gate index loop
         // Paper start - Perf: Remove streams from hot code
         for (final BehaviorControl<? super E> behavior : this.behaviors) {
             if (behavior.getStatus() == Behavior.Status.RUNNING) {
@@ -93,6 +109,17 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
     @Override
     public final void doStop(final ServerLevel level, final E body, final long timestamp) {
         this.status = Behavior.Status.STOPPED;
+        // FastPaper start - gate index loop
+        if (SWIFT_GATE_INDEX_LOOP) {
+            final List<ShufflingList.WeightedEntry<BehaviorControl<? super E>>> entries = this.behaviors.entries;
+            for (int i = 0; i < entries.size(); i++) {
