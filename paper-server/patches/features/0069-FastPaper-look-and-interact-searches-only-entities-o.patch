From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrakDv <business@drak.gg>
Date: Tue, 24 Nov 2026 00:22:29 -0500
Subject: [PATCH] FastPaper: look-and-interact searches only entities of the
 wanted type


diff --git a/net/minecraft/world/entity/ai/behavior/SetLookAndInteract.java b/net/minecraft/world/entity/ai/behavior/SetLookAndInteract.java
index b1a3523c2b8618d9b2c57d0d19e42eb63569b89d..86ebd802558d47dbec4b294350b8869befcba257 100644
--- a/net/minecraft/world/entity/ai/behavior/SetLookAndInteract.java
+++ b/net/minecraft/world/entity/ai/behavior/SetLookAndInteract.java
@@ -24,10 +24,13 @@ public class SetLookAndInteract {
                         // FastPaper start - look-and-interact type first: both checks are pure, so testing the cheap type
                         // match before the distance finds the same entity and runs the same line-of-sight tests
                         final NearestVisibleLivingEntities visible = i.<NearestVisibleLivingEntities>get(nearestEntities);
-                        Optional<LivingEntity> closest = SWIFT_TYPE_FIRST
+                        // FastPaper - look-and-interact type index: only the entries of that type are visited
+                        Optional<LivingEntity> closest = NearestVisibleLivingEntities.SWIFT_TYPE_INDEX
+                            ? visible.swift$findClosestOfType(type, e -> e.is(type) && e.distanceToSqr(body) <= interactionRangeSqr)
+                            : SWIFT_TYPE_FIRST
                             ? visible.findClosest(e -> e.is(type) && e.distanceToSqr(body) <= interactionRangeSqr)
                             : visible.findClosest(e -> e.distanceToSqr(body) <= interactionRangeSqr && e.is(type));
-                        if (SWIFT_TYPE_FIRST && io.papermc.paper.swift.SwiftVerify.ENABLED) {
+                        if ((SWIFT_TYPE_FIRST || NearestVisibleLivingEntities.SWIFT_TYPE_INDEX) && io.papermc.paper.swift.SwiftVerify.ENABLED) {
                             io.papermc.paper.swift.SwiftVerify.checked();
                             final Optional<LivingEntity> vanilla = visible.findClosest(e -> e.distanceToSqr(body) <= interactionRangeSqr && e.is(type));
                             if (!vanilla.equals(closest)) {
diff --git a/net/minecraft/world/entity/ai/memory/NearestVisibleLivingEntities.java b/net/minecraft/world/entity/ai/memory/NearestVisibleLivingEntities.java
index fd97abdc93671e4c62355bf1136bf8016cedc5a2..31ecc22dd34542125b4f4b5457c85cdef6924a38 100644
--- a/net/minecraft/world/entity/ai/memory/NearestVisibleLivingEntities.java
+++ b/net/minecraft/world/entity/ai/memory/NearestVisibleLivingEntities.java
@@ -53,6 +53,56 @@ public class NearestVisibleLivingEntities {
         return Optional.empty();
     }
 
+    // FastPaper start - look-and-interact type index
+    public static boolean SWIFT_TYPE_INDEX = Boolean.parseBoolean(System.getProperty("swift.lookInteractTypeIndex", "true")); // not final: tests compare both paths
+
+    /**
+     * The entries of {@link #nearbyEntities} that are of one entity type, in list order. An entity's type never
+     * changes and the sensor never edits the list after handing it over, so the index stays exact for the life of
+     * this object. The size is kept so a list that did change is noticed and indexed again. Final fields publish
+     * the array safely if another entity thread reads it.
+     */
+    private record SwiftTypeIndex(net.minecraft.world.entity.EntityType<?> type, int size, LivingEntity[] entries) {
+    }
+
+    private @org.jspecify.annotations.Nullable SwiftTypeIndex swift$typeIndex;
+
+    /**
+     * {@code findClosest(filter)} for a filter that only accepts entities of {@code type}: entities of other types
+     * fail the filter, so they never reach the line-of-sight test and skipping them finds the same entity after the
+     * same line-of-sight tests. Villagers ask this every tick for a player among everything their sensor saw.
+     */
+    public Optional<LivingEntity> swift$findClosestOfType(final net.minecraft.world.entity.EntityType<?> type, final Predicate<LivingEntity> filter) {
+        final List<LivingEntity> list = this.nearbyEntities;
+        final int size = list.size();
+        if (size == 0) {
+            return Optional.empty();
+        }
+        SwiftTypeIndex index = this.swift$typeIndex;
+        if (index == null || index.type() != type || index.size() != size) {
+            int count = 0;
+            LivingEntity[] entries = new LivingEntity[Math.min(size, 4)];
+            for (int i = 0; i < size; i++) {
+                final LivingEntity entity = list.get(i);
+                if (entity.is(type)) {
+                    if (count == entries.length) {
+                        entries = java.util.Arrays.copyOf(entries, Math.min(size, count * 2));
+                    }
+                    entries[count++] = entity;
+                }
+            }
+            index = new SwiftTypeIndex(type, size, count == entries.length ? entries : java.util.Arrays.copyOf(entries, count));
+            this.swift$typeIndex = index;
+        }
+        for (final LivingEntity entity : index.entries()) {
+            if (filter.test(entity) && this.lineOfSightTest.test(entity)) {
+                return Optional.of(entity);
+            }
+        }
+        return Optional.empty();
+    }
+    // FastPaper end - look-and-interact type index
+
     public Iterable<LivingEntity> findAll(final Predicate<LivingEntity> filter) {
         return Iterables.filter(this.nearbyEntities, entity -> filter.test(entity) && this.lineOfSightTest.test(entity)); // Leaf - Optimize baby villager sensor - diff on change
     }
