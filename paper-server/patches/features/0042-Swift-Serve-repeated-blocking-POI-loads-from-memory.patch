From: swiftality <155652101+Swift-ality@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:36:45 +0100
Subject: [PATCH] Swift: Serve repeated blocking POI loads from memory

PoiManager#getOrLoad on a chunk without loaded POI data parks the main
thread on a disk read (ChunkHolderManager#loadPoiChunk) and drops the
ticket right away, so callers asking every tick re-read it every tick.
Villagers whose job site is far away (PoiCompetitorScan, never
invalidated at that distance) did exactly that: about 190 blocking loads
in 200 ticks in a test, 0.54 ms/tick of waiting in profile qJwhW316qQ.

For 600 ticks after such a load, a per-world mirror keeps that chunk's
POI data as the disk holds it: the tag the disk read returned, replaced
by every later POI save of the chunk. A read with no read or write in
flight is answered from the mirror (Moonrise's existing immediate
completion path), so the bytes are the ones the disk read would return.
Holders, tickets, POI load/unload and the village distance tracker are
untouched. The first version kept the holder alive with a 600-tick
ticket, which also kept village-centre sources alive (sectionsToVillage
0 instead of 7 for 600 ticks; found by an adversarial review). In the
test the wait drops from 42 ms to 23 ms per 200 ticks, 1 region read.
See io.papermc.paper.swift.poi.PoiRetention. Disable with
-Dswift.poiRetain=false.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java b/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
index e9dc38d934ede23f17e18893ee207d9fbbd26449..44c1780c3e10802806760482263fa3d1b22ef8e8 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/io/MoonriseRegionFileIO.java
@@ -775,6 +775,17 @@ public final class MoonriseRegionFileIO {
             if (running == null) {
                 // not scheduled
 
+                // Swift start - serve repeated blocking POI loads from memory (no read or write in flight: the mirror holds what the disk holds)
+                if (type == RegionFileType.POI_DATA && io.papermc.paper.swift.poi.PoiRetention.enabled) {
+                    final CompoundTag[] mirrored = new CompoundTag[1];
+                    if (((ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().swiftPoiMirror.serve(keyInMap, mirrored)) {
+                        callbackInfo.data = mirrored[0];
+                        callbackInfo.completeNow = true;
+                        return null;
+                    }
+                }
+                // Swift end - serve repeated blocking POI loads from memory
+
                 // set up task
                 final ChunkIOTask newTask = new ChunkIOTask(
                     world, taskController, chunkX, chunkZ, priority, new ChunkIOTask.InProgressRead()
@@ -823,6 +834,10 @@ public final class MoonriseRegionFileIO {
 
         // needs to be scheduled
         if (callbackInfo.tasksNeedReadScheduling) {
+            if (type == RegionFileType.POI_DATA) {
+                io.papermc.paper.swift.poi.PoiRetention.DISK_READS.incrementAndGet(); // Swift start - serve repeated blocking POI loads from memory
+                ((ChunkSystemServerLevel)world).moonrise$getChunkTaskScheduler().swiftPoiMirror.onDiskRead(key); // Swift end
+            }
             taskController.startTask(ret);
             ret.scheduleReadIO();
         } else if (callbackInfo.completeNow) {
@@ -830,7 +845,7 @@ public final class MoonriseRegionFileIO {
                 final boolean copy = !(onComplete instanceof NoCopyNBTData);
                 onComplete.accept(callbackInfo.data == null ? null : (copy ? callbackInfo.data.copy() : callbackInfo.data), callbackInfo.throwable);
             } catch (final Throwable thr) {
-                LOGGER.error("Callback " + ConcurrentUtil.genericToString(onComplete) + " synchronously failed to handle chunk data for task " + ret.toString(), thr);
+                LOGGER.error("Callback " + ConcurrentUtil.genericToString(onComplete) + " synchronously failed to handle chunk data for task " + String.valueOf(ret), thr); // Swift - ret is null for a mirrored POI read
             }
         } else {
             // we're waiting on a task we didn't schedule, so raise its priority to what we want
diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
