@@ -1121,6 +1121,7 @@ public final class ChunkHolderManager {
             try {
                 current = this.getOrCreateChunkHolder(chunkX, chunkZ);
                 if (null == (ret = current.getPoiChunk())) {
+                    this.taskScheduler.swiftPoiMirror.markBlockingLoad(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(chunkX, chunkZ)); // Swift - serve repeated blocking POI loads from memory
                     loadTask = current.getOrLoadPoiData((final GenericDataLoadTask.TaskResult<PoiChunk, Throwable> result) -> {
                         completed.setPlain(result.left());
                         isCompleted.set(true);
@@ -1140,6 +1141,8 @@ public final class ChunkHolderManager {
         }
 
         if (loadTask != null) {
+            io.papermc.paper.swift.poi.PoiRetention.BLOCKING_LOADS.incrementAndGet(); // Swift - serve repeated blocking POI loads from memory
+            final long swiftWaitStart = System.nanoTime(); // Swift - serve repeated blocking POI loads from memory
             loadTask.schedule();
 
             // Note: no need to busy wait on the chunk queue, poi load will complete off-main
@@ -1153,6 +1156,7 @@ public final class ChunkHolderManager {
             if (interrupted) {
                 Thread.currentThread().interrupt();
             }
+            io.papermc.paper.swift.poi.PoiRetention.WAIT_NANOS.addAndGet(System.nanoTime() - swiftWaitStart); // Swift - serve repeated blocking POI loads from memory
 
             ret = completed.getPlain();
         } // else: became loaded during the scheduling attempt, need to ensure load() is invoked
